# .env.example
#
# Copy this file to .env and fill in your account values.
# .env is gitignored — never commit it.
#
# Run: uv run python tests/live/scripts/bootstrap.py

# REQUIRED: path to the OAuth client secret JSON downloaded from Google Cloud Console.
# This is the file with installed-app credentials. Used by `suitewright auth init`.
# Default points at the dev-mode auth directory (../suitewright-auth relative to repo root).
# Use an absolute path if you keep it elsewhere.
SUITEWRIGHT_LIVE_TEST_CLIENT_SECRET=../suitewright-auth/google_client_secret.json

# OPTIONAL: Google account email used as both sender and primary recipient
# for self-addressed test emails. Leave blank to use the authenticated account.
SUITEWRIGHT_LIVE_TEST_EMAIL=

# OPTIONAL: calendar ID for create/list/delete event tests. Defaults to "primary".
# Use a dedicated test calendar ID if you don't want events on your primary calendar.
SUITEWRIGHT_LIVE_TEST_CALENDAR_ID=primary

# OPTIONAL: prefix for all created sandbox resources. Defaults to "suitewright-live-test".
# Useful when running parallel suites or distinguishing CI vs local.
SUITEWRIGHT_LIVE_TEST_PREFIX=suitewright-live-test

# OPTIONAL: Drive folder ID to use as the parent for all sandbox run folders.
# If set, every per-run sandbox folder is created inside this folder instead of
# Drive root. Create it once with:
#   uv run suitewright drive create-folder "suitewright-tests"
# then paste the returned "id" value here.
SUITEWRIGHT_LIVE_TEST_ROOT_FOLDER_ID=

# OPTIONAL: suitewright path overrides. Leave blank to use suitewright's normal
# resolution (dev mode -> ./auth and ./cache; otherwise XDG defaults).
# These are the same env vars suitewright itself reads — set here only if your
# live-test environment needs to point at a different token/cache.
SUITEWRIGHT_TOKEN_PATH=
SUITEWRIGHT_CLIENT_SECRET_PATH=
SUITEWRIGHT_CACHE_DIR=
SUITEWRIGHT_ROOT=
